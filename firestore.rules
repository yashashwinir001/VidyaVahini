rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.id == userId &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.email == request.auth.token.email &&
               (data.get('selectedRouteId', null) == null || data.selectedRouteId is string);
      }

      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isEmailVerified() && isValidUser(incoming()) && incoming().keys().hasAll(['id', 'displayName', 'email']) && incoming().keys().size() >= 3;
      allow update: if isSignedIn() && isEmailVerified() && request.auth.uid == userId && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'selectedRouteId', 'email'])
      );
    }

    // --- Route Rules ---
    match /routes/{routeId} {
      allow read: if isSignedIn();
      // Allow creation for seeding or admins (simplified for demo)
      allow create: if isSignedIn(); 
    }

    // --- Update Rules (Pings/Breakdowns) ---
    match /routes/{routeId}/updates/{updateId} {
      function isValidUpdate(data) {
        return data.id == updateId &&
               data.stopId is string &&
               data.timestamp == request.time &&
               data.type in ['ping', 'breakdown'] &&
               data.reporterId == request.auth.uid &&
               isValidId(routeId);
      }

      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isEmailVerified() && isValidUpdate(incoming()) && incoming().keys().hasAll(['id', 'stopId', 'timestamp', 'type', 'reporterId', 'reporterName']) && incoming().keys().size() >= 6;
      allow update, delete: if false;
    }
  }
}
